#!/usr/bin/env python3
"""flywheel-migrate — move a change's tasks.md onto the tracker, mid-flight.

  flywheel-migrate --org ORG --repo REPO --change PATH [--milestone TITLE]
                   [--dry-run]

Reads the change directory's `tasks.md` and creates one tracker item per
UNCHECKED task line: title from the line, body from the full task text
(continuation lines included, blockers quoted), the section heading mapped
to a `type:*` label, and `state:queued` — or `state:ready` for handoff
lines already marked RELEASED. Checked lines are history and stay in git.

The milestone defaults to `intent/<dirname>` (`bolt/<dirname>` when the
change's `.openspec.yaml` binds a bolt schema) and is created if missing;
writeback-typed items go to `intent/writeback-<dirname>` instead, the
convention the roadmap groups them by.
Dependencies are left as quoted blocker text in each body — wire the
native blocked-by relations when batching, when the numbers exist to
point at. Released items are listed at the end for `flywheel-epic` to
compose.

Deleting the migrated `tasks.md` is the operator's commit, made in the
change's repo after reviewing what landed. `--dry-run` prints every item
instead of creating anything.
"""

import argparse
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _flywheel_gh import ensure_milestone, gh, resolve_token

TYPE_WORDS = {
    "design": "planning", "planning": "planning", "research": "research",
    "prototype": "prototype", "writeback": "writeback", "handoff": "handoff",
    "spec": "spec-writing", "review": "proposal-review", "build": "build",
    "test": "test", "merge": "build",
}
LINE_TYPE_HINTS = {
    "research:": "research", "triage:": "research", "book:": "writeback",
    "map:": "writeback", "doc:": "writeback", "design session:": "planning",
}


def parse_tasks(text):
    """Yield (section, checked, released, title, body) per task line."""
    section = ""
    current = None
    for line in text.splitlines():
        heading = re.match(r"##\s+(.*)", line)
        box = re.match(r"- \[( |x)\]\s+(.*)", line)
        if heading:
            if current:
                yield current
                current = None
            section = heading.group(1).strip()
        elif box:
            if current:
                yield current
            checked = box.group(1) == "x"
            first = box.group(2).strip()
            current = [section, checked, first.startswith("RELEASED"),
                       first, [first]]
        elif current and line.startswith((" ", "\t")) and line.strip():
            current[4].append(line.strip())
        elif current and not line.strip():
            pass
        elif current:
            yield current
            current = None
    if current:
        yield current


def item_type(section, title):
    for prefix, t in LINE_TYPE_HINTS.items():
        if title.lower().startswith(prefix):
            return t
    return TYPE_WORDS.get(section.lower().split()[0] if section else "", None)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--org", required=True)
    ap.add_argument("--repo", required=True)
    ap.add_argument("--change", required=True, metavar="PATH")
    ap.add_argument("--milestone", metavar="TITLE")
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()

    change = Path(args.change)
    tasks_file = change / "tasks.md"
    if not tasks_file.is_file():
        sys.exit(f"flywheel-migrate: no tasks.md under {change}")

    milestone = args.milestone
    if not milestone:
        kind = "intent"
        spec_binding = change / ".openspec.yaml"
        if spec_binding.is_file() and "bolt" in spec_binding.read_text():
            kind = "bolt"
        milestone = f"{kind}/{change.name}"

    items = []
    for section, checked, released, title, lines in parse_tasks(
            tasks_file.read_text()):
        if checked:
            continue
        body_text = " ".join(lines)
        blockers = re.findall(r"\(blocked by:\s*([^)]*)\)", body_text)
        t = item_type(section, title)
        title_clean = re.sub(r"^(RELEASED|STAGED)(\s*→)?[^—]*—\s*", "",
                             body_text)
        title_clean = re.sub(r"^[a-z ]+:\s*", "", title_clean)
        title_clean = re.split(
            r"[.;]\s|\s\(blocked|"
            r"\s→\s(?=assertions/|sessions/|decisions/|questions/|openspec/)",
            title_clean, maxsplit=1)[0].strip()
        if len(title_clean) > 100:
            title_clean = title_clean[:100].rsplit(" ", 1)[0] + "…"
        title_clean = title_clean or title[:100]
        labels = ["state:ready" if released else "state:queued"]
        if t:
            labels.append(f"type:{t}")
        body = body_text
        if blockers:
            body += "\n\nblocked by (wire the relation when the numbers exist): " \
                    + "; ".join(blockers)
        body += f"\n\nmigrated from `{tasks_file}` · section: {section}"
        ms_title = milestone
        if t == "writeback" and milestone.startswith("intent/"):
            ms_title = "intent/writeback-" + milestone.removeprefix("intent/")
        items.append((title_clean, labels, body, released, ms_title))

    print(f"{len(items)} unchecked lines → '{milestone}'"
          + (" (+ writeback milestone)" if any(
              m != milestone for *_, m in items) else ""))
    if args.dry_run:
        for title, labels, _, _, ms_title in items:
            print(f"  [{' '.join(labels)}] ({ms_title}) {title}")
        return

    token = resolve_token(args.org)
    ms_numbers = {}
    released_numbers = []
    for title, labels, body, released, ms_title in items:
        if ms_title not in ms_numbers:
            ms_numbers[ms_title] = ensure_milestone(
                token, args.org, args.repo, ms_title)
        issue = gh(token, "api", f"/repos/{args.org}/{args.repo}/issues",
                   "--input", "-", input_json={
                       "title": title, "body": body,
                       "labels": labels, "milestone": ms_numbers[ms_title]})
        print(f"  #{issue['number']} {title}")
        if released:
            released_numbers.append(str(issue["number"]))
    if released_numbers:
        print("released items — compose with: flywheel-epic --org "
              f"{args.org} --repo {args.repo} --milestone '{milestone}' "
              f"--title '<batch>' {' '.join(released_numbers)}")


if __name__ == "__main__":
    main()

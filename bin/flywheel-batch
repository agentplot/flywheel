#!/usr/bin/env python3
"""flywheel-batch — compose a proposed batch from queued items.

  flywheel-batch --org ORG --repo REPO --kind {unit,elaboration} \\
      --milestone TITLE --title TITLE [--body TEXT] [--project Flywheel] \\
      [--due YYYY-MM-DD] [--start YYYY-MM-DD] [--target YYYY-MM-DD] \\
      ITEM_NUMBER ...

A batch is a parent issue whose sub-issues are the batch, and its kind
is what approving it authorizes: a **unit** releases construction work
(AI-DLC's unit of work — a handoff's assertions, or fresh work on a
live bolt); an **elaboration** authorizes design sessions on an
intent. The conductor's batching move, in one call: creates the parent
issue (labels `<kind>` + `state:queued`, in the named milestone,
created if missing), attaches the items as sub-issues, adds the parent
to the org Project, and sets its Status to **Backlog**. Dates default
aggressively — Start and Target default to today, and a new milestone
is due today — because automation comes first; pass `--start`,
`--target`, `--due` with a stated reason when the work is bigger.
Moving it to **Ready** on the board is the operator's act — this tool
never does.

Prints the batch's number and URL. Token: `GH_TOKEN`, or minted by the
sibling `flywheel-token` from `FLYWHEEL_GH_*`.
"""

import argparse
import datetime
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _flywheel_gh import (GraphqlError, add_to_project, ensure_milestone,
                          find_project, gh, graphql, project_date_field,
                          project_single_select, resolve_token,
                          set_item_option, set_item_value)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--org", required=True)
    ap.add_argument("--repo", required=True)
    ap.add_argument("--kind", required=True, choices=["unit", "elaboration"])
    ap.add_argument("--milestone", required=True, metavar="TITLE")
    ap.add_argument("--title", required=True)
    ap.add_argument("--body", default="")
    ap.add_argument("--project", default="Flywheel", metavar="TITLE")
    ap.add_argument("--due", metavar="YYYY-MM-DD")
    ap.add_argument("--start", metavar="YYYY-MM-DD")
    ap.add_argument("--target", metavar="YYYY-MM-DD")
    ap.add_argument("items", nargs="+", type=int, metavar="ITEM_NUMBER")
    args = ap.parse_args()

    # Dates default aggressively — automation first: the batch starts
    # today and is due today. An agent that judges the work bigger
    # overrides with later dates and a stated reason.
    today = datetime.date.today().isoformat()
    args.start = args.start or today
    args.target = args.target or today

    token = resolve_token(args.org)
    repo_path = f"/repos/{args.org}/{args.repo}"

    # Fetch every item up front: composing a batch from a missing item or
    # one already batched should fail before anything is created.
    items = [gh(token, "api", f"{repo_path}/issues/{n}") for n in args.items]
    for item in items:
        if item.get("parent_issue_url"):
            parent = item["parent_issue_url"].rsplit("/", 1)[-1]
            sys.exit(f"flywheel-batch: #{item['number']} is already in batch "
                     f"#{parent} — an item joins exactly one batch")

    ms_number = ensure_milestone(token, args.org, args.repo,
                                 args.milestone, due_on=args.due)

    # The batch answers to whoever its items answer to: the union of its
    # items' assignees, so the board and DM routing resolve on the parent.
    assignees = sorted({a["login"] for i in items
                        for a in i.get("assignees") or []})
    batch = gh(token, "api", f"{repo_path}/issues", "--input", "-",
               input_json={
                   "title": args.title,
                   "body": args.body,
                   "labels": [args.kind, "state:queued"],
                   "milestone": ms_number,
                   **({"assignees": assignees[:10]} if assignees else {}),
               })
    print(f"{args.kind} #{batch['number']}: {batch['html_url']}"
          + (f" · assignees: {', '.join(assignees[:10])}" if assignees else ""))

    for item in items:
        gh(token, "api", f"{repo_path}/issues/{batch['number']}/sub_issues",
           "--input", "-", input_json={"sub_issue_id": item["id"]})
        print(f"  sub-issue: #{item['number']} {item['title']}")

    project_id = find_project(token, args.org, args.project)
    if not project_id:
        sys.exit(f"flywheel-batch: no project titled '{args.project}' — "
                 "run flywheel-setup first")
    item_id = add_to_project(token, project_id, batch["node_id"])
    field_id, options = project_single_select(token, project_id, "Status")
    if "Backlog" not in options:
        sys.exit("flywheel-batch: the Status field has no 'Backlog' option — "
                 "run flywheel-setup first")
    set_item_option(token, project_id, item_id, field_id, options["Backlog"])
    for name, date in (("Start", args.start), ("Target", args.target)):
        if date:
            f_id = project_date_field(token, project_id, name)
            if not f_id:
                sys.exit(f"flywheel-batch: no '{name}' date field — "
                         "run flywheel-setup first")
            set_item_value(token, project_id, item_id, f_id, {"date": date})
    extras = [x for x in (args.start and f"start {args.start}",
                          args.target and f"target {args.target}",
                          args.due and f"milestone due {args.due}") if x]
    print(f"  status: Backlog, in '{args.project}', "
          f"milestone '{args.milestone}'"
          + (" · " + ", ".join(extras) if extras else ""))


if __name__ == "__main__":
    try:
        main()
    except GraphqlError as e:
        sys.exit(f"flywheel-batch: graphql: {e}")

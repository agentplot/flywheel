#!/usr/bin/env python3
"""flywheel — drive an org fleet from its manifest and its tracker.

  flywheel status [--host H] [--fleet PATH]
  flywheel up     [--host H] [--fleet PATH]
  flywheel server [--host H] [--fleet PATH] [--interval SECONDS]
                  [--once] [--dry-run]
  flywheel down   [--fleet PATH]
  flywheel version

The manifest is `fleet.yaml` at the org folder root — the directory above
the org's repos — found by walking up from the working directory (or
named explicitly with --fleet). It is not checked into git: placement is
machine-local. `cwd:` entries are relative to the manifest's directory.

`server` is the daemon. The operator starts it on any host they want in
the fleet; it runs the reconcile pass every 60 seconds and starts or
stops ONE LOOP PROCESS per milestone with a job — `flywheel-bolt-loop`
for a `bolt/*` milestone, `flywheel-intent-loop` for an `intent/*` one —
and runs a one-shot archive for a closed milestone whose change still
sits in `openspec/changes/`. No job stops the process; the loops are
stateless, so a later job starts a fresh one that re-reads the tracker
and the records. Multi-host is a server per host sharing the tracker: a
board Team routes its milestone through the manifest's `teams:` map, and
a server takes only the loops that map to it. Loops start in
`loops_cwd:`. Operator visibility is the server's log.

The pass decides nothing itself. The job list is the tracker's server
inbox filter (`_flywheel_inbox.server_inbox`), the arithmetic over it is
a pure function of manifest + tracker + the live registry, and the
judgment lives in the sessions the loops launch.

`up` converges the manifest's standing rows — dispatch, the one standing
agent, whose triage and relay need a mind and a Discord channel — and
then starts the server, detached, if none is running here for this org.

The fleet's agents run in their own named herdr session — the org's — so
the roster, workspaces, and teardown are isolated from other work. The
session name is the manifest's `session:` field, defaulting to the org
folder's name with any `github_` prefix dropped (github_willdan → the
session `willdan`). When that session is not running, this command says so
and names the start command rather than starting agents into the wrong
session.

Placement only: this command starts and reports actors; it never decides
what they own (the tracker items' assignee does) and never tears a
manifest row down (teardown is deliberate, not a sync step). Rows on
other hosts are reported, not driven.

Before starting any actor, the repo it would sit in must have its
worktrunk hook approvals granted — every project hook template worktrunk
resolves for that repo present verbatim in the operator's
`~/.config/worktrunk/approvals.toml`. Ungranted, an agent cannot run the
merge gate and would stop mid-merge with no way to fix it, so no actor
is started there and `wt config approvals add` is printed instead. The
grant is the operator's, taken once per repo, interactively.

Worktrunk is asked, read-only, which hooks a repo configures — its own
grammar, not ours to parse. The store is read here and compared. Nothing
asks worktrunk whether a template is approved, nothing writes the store,
and no hook is ever run. `status` reports a row per repo it can inspect,
names what it could not inspect and why, and starts nothing.

The manifest is a constrained YAML subset parsed here without a YAML
dependency: two-space indentation, top-level scalars, `actors:` a list
of flat maps, `hosts:` a map of flat maps, scalar values only. Only
FULL-LINE comments are recognized — a `#` inside a value is part of the
value.
"""

import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
import tomllib
from pathlib import Path
from typing import NamedTuple

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _flywheel_inbox as inbox    # noqa: E402
import _flywheel_server as server  # noqa: E402
from _flywheel_gh import GraphqlError, resolve_token  # noqa: E402

STATES = {"running", "parked"}

# Two manifest keys retired with the agent fleet they configured: one named
# the directory those agents started in, the other the model they launched
# on. The server starts loop PROCESSES, which have a working directory and no
# model. A manifest still carrying either key is stale in a way that would
# otherwise be silent — the server would look for `loops_cwd:`, find nothing
# and start nothing — so these are named, matched, and refused with the fix.
# `fleet.yaml` is machine-local and no commit can migrate it; only a message
# can. The strings below are that matcher, not a live reference.
RETIRED_KEYS = {
    "conductors_cwd": "loops_cwd",
    "conductor_model": None,
}


def find_manifest(override: str | None) -> Path:
    if override:
        p = Path(override).expanduser().resolve()
        if not p.is_file():
            sys.exit(f"--fleet {override}: no such file")
        return p
    cur = Path.cwd().resolve()
    for d in [cur, *cur.parents]:
        candidate = d / "fleet.yaml"
        if candidate.is_file():
            return candidate
    sys.exit("no fleet.yaml found walking up from here — the manifest lives "
             "at the org folder root; pass --fleet to name one explicitly")


def parse_manifest(path: Path) -> dict:
    hosts: dict[str, dict] = {}
    actors: list[dict] = []
    teams: dict[str, str] = {}
    top: dict[str, str] = {}
    section = None
    current: dict | None = None
    current_host = None
    for raw in path.read_text().splitlines():
        if raw.lstrip().startswith("#") or not raw.strip():
            continue
        line = raw.rstrip()
        if line == "hosts:":
            section, current = "hosts", None
        elif line == "actors:":
            section, current = "actors", None
        elif line == "teams:":
            section, current = "teams", None
        elif not line.startswith(" ") and ":" in line:
            # a top-level key anywhere ends the current section — never
            # silently absorbed into the last actor or host
            section, current, current_host = None, None, None
            k, _, v = line.partition(":")
            top[k.strip()] = v.strip().strip('"')
        elif section == "hosts" and line.startswith("  ") and not line.startswith("    "):
            current_host = line.strip().rstrip(":")
            hosts[current_host] = {}
        elif section == "hosts" and line.startswith("    ") and current_host:
            k, _, v = line.strip().partition(":")
            hosts[current_host][k] = v.strip().strip('"')
        elif section == "actors" and line.lstrip().startswith("- "):
            current = {}
            actors.append(current)
            k, _, v = line.lstrip()[2:].partition(":")
            current[k.strip()] = v.strip().strip('"')
        elif section == "actors" and current is not None:
            k, _, v = line.strip().partition(":")
            current[k.strip()] = v.strip().strip('"')
        elif section == "teams" and line.startswith("  "):
            k, _, v = line.strip().partition(":")
            teams[k.strip()] = v.strip().strip('"')
    manifest = {"top": top, "hosts": hosts, "actors": actors,
                "teams": teams, "root": path.parent}
    validate(manifest)
    return manifest


def validate(manifest: dict) -> None:
    problems = []
    for key, replacement in RETIRED_KEYS.items():
        if key in manifest["top"]:
            problems.append(
                f"`{key}:` retired with the agent fleet — "
                + (f"rename it to `{replacement}:`" if replacement
                   else "drop it; a loop process has no model"))
    for a in manifest["actors"]:
        name = a.get("name", "<unnamed>")
        for field in ("name", "profile", "host", "state", "cwd"):
            if not a.get(field):
                problems.append(f"{name}: missing {field}")
        if a.get("state") and a["state"] not in STATES:
            problems.append(f"{name}: state '{a['state']}' is not one of {sorted(STATES)}")
        if a.get("host") and a["host"] not in manifest["hosts"]:
            problems.append(f"{name}: host '{a['host']}' is not in hosts:")
        if a.get("cwd", "").startswith("/"):
            problems.append(f"{name}: cwd is absolute — cwd: entries are "
                            "relative to the manifest's directory")
    for team, host in manifest["teams"].items():
        if host not in manifest["hosts"]:
            problems.append(f"teams: {team} → '{host}' is not in hosts:")
    if problems:
        sys.exit("manifest invalid:\n  " + "\n  ".join(problems))


def session_env(manifest: dict) -> tuple[str, dict]:
    name = manifest["top"].get("session") or manifest["root"].name
    # normalize an org folder like github_willdan to its plain org name
    name = re.sub(r"^github_", "", name)
    if shutil.which("herdr") is None:
        sys.exit("herdr not on PATH — the fleet is not addressable from here")
    out = subprocess.run(["herdr", "session", "list"], capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"herdr session list failed: {out.stderr.strip()}")
    sock = None
    for line in out.stdout.splitlines()[1:]:
        cols = line.split()
        if len(cols) >= 4 and cols[0] == name and cols[1] == "running":
            sock = cols[-1]
    if not sock:
        sys.exit(f"the fleet's herdr session '{name}' is not running — start "
                 f"it with:  herdr --session {name}\nthen re-run this command")
    env = dict(os.environ, HERDR_SOCKET_PATH=sock)
    return name, env


def herdr_json(argv: list[str], env: dict) -> dict:
    out = subprocess.run(argv, capture_output=True, text=True, env=env)
    if out.returncode != 0:
        raise RuntimeError(f"{' '.join(argv)} failed: {out.stderr.strip()}")
    try:
        return json.loads(out.stdout or "{}")
    except json.JSONDecodeError as e:
        raise RuntimeError(f"{' '.join(argv)} returned unparseable output: {e}")


def herdr_agents(env: dict) -> dict[str, dict]:
    try:
        data = herdr_json(["herdr", "agent", "list"], env)
    except RuntimeError as e:
        sys.exit(str(e))
    rows = data.get("result", {}).get("agents", [])
    return {
        (a.get("name") or a.get("terminal_title_stripped", "")): a
        for a in rows
        if isinstance(a, dict)
    }


def this_host(manifest: dict, override: str | None) -> str:
    if override:
        if override not in manifest["hosts"]:
            sys.exit(f"--host {override} is not in hosts:")
        return override
    hostname = socket.gethostname().split(".")[0].lower()
    for name, cfg in manifest["hosts"].items():
        if cfg.get("hostname", "").split(".")[0].lower() == hostname and hostname:
            return name
    for name, cfg in manifest["hosts"].items():
        if str(cfg.get("default", "")).lower() == "true":
            print(f"note: no hosts: entry matches hostname '{hostname}'; "
                  f"assuming '{name}' (default: true)")
            return name
    sys.exit("no --host given, no hostname match, no default host in hosts:")


# --- the hook-approval precondition -------------------------------------
#
# worktrunk runs a project hook only against the operator's standing grant,
# so a repo whose hooks are ungranted is a repo whose merge gate its agents
# cannot run. Placing an actor there buys a stoppage mid-merge, on an agent
# that cannot fix it. This check makes the grant a start precondition: it
# takes the repo's project hook templates from worktrunk, compares them
# against the operator's approvals store, and refuses the start — so the
# stoppage happens here, loudly, with the remedy in hand.
#
# It READS. It never writes the approvals store, never asks `wt` whether
# a template is approved, and never runs a hook — a converger that wrote
# the grants was considered and declined, because the machinery would then
# be approving the machinery's own hooks. See
# openspec/changes/gated-merge-guarantee/decisions/
#   approvals-are-an-onboarding-grant.md.
#
# The line, drawn once in openspec/changes/merge-gate-remedy/bolt.md under
# *Where `wt` is the authority, and where it is not*: worktrunk is the
# authority on its own configuration — the project identifier, and what
# counts as a hook template. The approvals store is the authority on
# grants, and that comparison is ours alone.
#
# Which hooks a repo configures is worktrunk's own question, and it is
# asked of worktrunk rather than parsed here: the project-hook grammar has
# six accepted spellings and is free to grow a seventh. What this file owns
# is the comparison against the operator's grants.
APPROVALS_STORE = Path("~/.config/worktrunk/approvals.toml")
REMEDY = "wt config approvals add"


class Indeterminate(Exception):
    """The check could not be made for one repo, with the reason the fleet
    composes for the operator. Never escapes as an error: it becomes an
    indeterminate verdict for that repo, and the pass carries on."""


class GateCheck(NamedTuple):
    """A repo's gate-readiness. `state` is one of three, never two:

    ready          — every hook template it defines is granted, or it
                     defines none at all (no gate to be unable to run)
    ungranted      — it defines templates the store does not carry;
                     `missing` names them and the remedy applies
    indeterminate  — the check could not be made (worktrunk unavailable,
                     its query failing, an unreadable store). Fails closed
                     like `ungranted`, but says so differently: "we could
                     not tell" and "there is no grant" are different
                     sentences to an operator holding a remedy command.
    """
    key: str
    state: str
    identifier: str | None = None
    templates: tuple[str, ...] = ()
    missing: tuple[str, ...] = ()
    reason: str | None = None

    @property
    def ok(self) -> bool:
        return self.state == "ready"


def wt_project(cwd: Path) -> dict:
    """worktrunk's own answer to "which project is this, and is there a
    project config in force". Raises on any doubt, so the caller fails
    closed.

    This asks for identity, not for approval state — the reply carries none
    at all (measured). Whether a template is granted is decided further
    down, by comparing worktrunk's templates against the operator's store.
    """
    project = wt_json(["config", "show"], cwd,
                      "resolve this repo's worktrunk project identity")
    if not isinstance(project, dict):
        raise Indeterminate("`wt config show --format json` returned "
                            "something other than an object")
    project = project.get("project")
    return project if isinstance(project, dict) else {}


def toml_fault(path: Path) -> str | None:
    """Why this file will not parse, or None. Reads the file itself — the
    same file the check already reads — never a tool's error stream."""
    if not path.is_file():
        return None
    try:
        tomllib.loads(path.read_text())
    except (OSError, ValueError) as e:
        return str(e)
    return None


def store_fault() -> str | None:
    """Whether the operator's approvals store is itself what worktrunk
    choked on — for attribution only, never for a verdict.

    worktrunk reads this store to compute its own approval state, so a
    malformed store makes worktrunk refuse to enumerate a repo's hooks. The
    exit code then looks exactly like a broken project config, and sending
    an operator to `.config/wt.toml` — version-controlled, shared, and in
    that case blameless — is a misdirection at the moment they have least
    context.

    Measured against `wt 5fba0bd`, the store's schema is strict at both
    levels: `projects` is the only key it accepts at the top, and
    `approved-commands` the only key inside a project's table. Both
    rejections are worded as `unknown field`. That strictness is what lets
    this attribute the fault instead of guessing.

    Deliberately NOT used to decide gate-readiness: a future worktrunk that
    accepts a new key here would make this probe call a healthy store
    malformed, and that must never refuse a start on its own. It only ever
    changes the wording of a message that is already indeterminate.
    """
    store = APPROVALS_STORE.expanduser()
    if not store.is_file():
        return None
    fault = toml_fault(store)
    if fault:
        return f"{store} could not be parsed ({fault})"
    try:
        data = tomllib.loads(store.read_text())
    except (OSError, ValueError):  # pragma: no cover — toml_fault caught it
        return None

    def bad(what: str) -> str:
        return f"{store} is not shaped as worktrunk reads it: {what}"

    unknown = [k for k in data if k != "projects"]
    if unknown:
        return bad(f"unknown top-level key `{unknown[0]}`")
    projects = data.get("projects")
    if projects is None:
        return None
    if not isinstance(projects, dict):
        return bad("`projects` is not a table")
    for ident, table in projects.items():
        if not isinstance(table, dict):
            return bad(f"the entry for {ident} is not a table")
        stray = [k for k in table if k != "approved-commands"]
        if stray:
            return bad(f"unknown key `{stray[0]}` under {ident}")
        commands = table.get("approved-commands")
        if commands is None:
            continue
        if not isinstance(commands, list):
            return bad(f"{ident}'s `approved-commands` is not an array")
        if not all(isinstance(c, str) for c in commands):
            return bad(f"{ident}'s `approved-commands` holds a non-string")
    return None


def wt_failure_reason(args: list[str], code: int, cwd: Path, what: str) -> str:
    """Name the file that is actually at fault when worktrunk exits non-zero.

    worktrunk loads two files here — the repo's project config and the
    operator's approvals store — and its exit code alone does not say
    which. The check already reads both, so it asks them rather than
    reaching for worktrunk's stderr.

    Both are tested before anything is said, and all four combinations get
    their own sentence. Exculpating one file is a claim, and it is only
    made when it is true: a message that clears the repo's
    version-controlled config while that config is *also* broken sends an
    operator hunting in the wrong place, which is the same misdirection as
    naming the wrong file outright. Where both are faulted, both are named
    and the store leads, because worktrunk fails on the store first and
    that is genuinely the next thing to fix. Where neither can be faulted,
    both are named without blame rather than one picked on a guess.
    """
    cmd = f"`wt {' '.join(args)}`"
    store = APPROVALS_STORE.expanduser()
    config = Path(repo_key(cwd)) / ".config" / "wt.toml"
    store_bad = store_fault()
    config_bad = toml_fault(config)

    if store_bad and config_bad:
        return (f"{cmd} exited {code} — both files worktrunk loads here are "
                f"broken. The approvals store {store_bad}. This repo's "
                f"{config} could not be parsed either ({config_bad}). "
                "worktrunk fails on the store first, so fix that one first; "
                "the repo's config still needs fixing after it.")
    if store_bad:
        return (f"{cmd} exited {code} — worktrunk also loads the approvals "
                f"store, and {store_bad}. That file is the fault, not this "
                f"repo's configuration.")
    if config_bad:
        return (f"{cmd} exited {code} — this repo's {config} could not be "
                f"parsed ({config_bad}), so the fleet could not {what}.")
    return (f"{cmd} exited {code}, so the fleet could not {what}. Both this "
            f"repo's {config} and the approvals store {store} parse here, so "
            "run that command in the repo to see which worktrunk objects to.")


def wt_json(args: list[str], cwd: Path, what: str):
    """Run one read-only worktrunk query and return its parsed JSON.

    Raises `Indeterminate` on every doubt, with a reason this function
    composes. worktrunk's own error stream is deliberately not relayed: it
    is multi-line and ANSI-coloured, so it renders badly inside a flywheel
    refusal, and its approval-failure text suggests `--yes` — a bypass this
    loop forbids and must never repeat to an operator, even as a quotation.
    """
    if not shutil.which("wt"):
        raise Indeterminate("the worktrunk command `wt` is not on PATH, so "
                            "the fleet cannot ask it which hooks this repo "
                            "configures")
    argv = ["wt", *args, "--format", "json", "-C", str(cwd)]
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        raise Indeterminate(f"`wt {' '.join(args)}` could not be run "
                            f"({type(e).__name__}), so the fleet could not "
                            f"{what}") from e
    if out.returncode != 0:
        # Load-bearing, not incidental: with a config worktrunk cannot
        # load, `wt hook show` exits 1 with EMPTY STDOUT. Reading that as
        # "no hooks configured" would resolve a repo whose gate config is
        # broken to gate-ready — a false green on a repo whose gate is
        # definitionally unrunnable.
        raise Indeterminate(wt_failure_reason(args, out.returncode, cwd, what))
    try:
        # stdout only — wt writes terminal control bytes to stderr, and
        # folding them in makes the document unparseable.
        return json.loads(out.stdout)
    except ValueError as e:
        raise Indeterminate(f"`wt {' '.join(args)} --format json` returned "
                            f"output the fleet could not parse ({e})") from e


def project_hook_templates(cwd: Path) -> tuple[str, ...]:
    """Every hook template worktrunk resolves from the repo's *project*
    config, taken from worktrunk's own enumeration.

    The grammar is worktrunk's, not ours, and it is wider than it looks: an
    event's value may be a bare string, a named table, an inline table, an
    array of strings, an array mixing strings and tables, or `[[event]]`
    pipeline blocks. Parsing it here is how the first build of this check
    reported repos gate-ready whose hooks were entirely ungranted — four of
    the six spellings were invisible to it. Asking worktrunk to enumerate
    costs one subprocess and cannot fall behind the grammar.

    Two traps, both measured, both fatal to a hand-written version:

    * A `[[event]]` block's keys are COMMAND NAMES, not metadata. A block
      written `name = "delta"` / `command = "echo delta"` is two commands —
      one called `name` running `delta`, one called `command` running
      `echo delta` — and worktrunk runs both. So records are never filtered
      on what a key is called; the only filter is `source`.
    * `needs_approval` is approval state. It is worktrunk's answer to a
      question the store owns, and the assertion forbids sourcing it here.
      It is not read.

    Only project hooks need approval; the operator's own user-level hooks
    do not, and are not counted as gaps.
    """
    records = wt_json(["hook", "show"], cwd,
                      "enumerate the hooks this repo configures")
    if not isinstance(records, list):
        raise Indeterminate("`wt hook show --format json` returned something "
                            "other than a list of hook records")
    templates = []
    for record in records:
        if not isinstance(record, dict) or record.get("source") != "project":
            continue
        template = record.get("template")
        # A project hook whose template is not a string is a shape this
        # check does not understand. Dropping it quietly is how the first
        # build of this check went wrong: a hook worktrunk would run,
        # answered with silence and a gate-ready verdict. Every sibling
        # shape surprise says "we could not tell", and so does this one.
        if not isinstance(template, str):
            raise Indeterminate(
                "`wt hook show` reported a project hook whose template is "
                f"not a string ({type(template).__name__}), a shape this "
                "check does not understand")
        templates.append(template)
    return tuple(templates)


def granted_commands(identifier: str) -> tuple[str, ...]:
    """The operator's grants for one project identifier.

    Absent and malformed are different answers. A store that does not
    exist, holds no table for this identifier, or holds an empty array all
    mean "no grants" — an ungranted repo, with a remedy that applies. A
    store that will not parse, or is not shaped the way this check reads
    it, means "we could not tell", and raises so the repo comes out
    indeterminate. The decision record calls this file's shape explicitly
    unsettled, so a reshape is the named risk, not a hypothetical.
    """
    store = APPROVALS_STORE.expanduser()
    if not store.is_file():
        return ()
    try:
        data = tomllib.loads(store.read_text())
    except (OSError, ValueError) as e:
        raise Indeterminate(f"the approvals store {store} could not be read "
                            f"({e})") from e

    def wrong(what: str) -> Indeterminate:
        return Indeterminate(f"the approvals store {store} is not shaped as "
                             f"this check reads it: {what}")

    projects = data.get("projects")
    if projects is None:
        return ()
    if not isinstance(projects, dict):
        raise wrong("`projects` is not a table")
    table = projects.get(identifier)
    if table is None:
        return ()
    if not isinstance(table, dict):
        raise wrong(f"the entry for {identifier} is not a table")
    commands = table.get("approved-commands")
    if commands is None:
        return ()
    if not isinstance(commands, list):
        raise wrong(f"{identifier}'s `approved-commands` is not an array")
    if not all(isinstance(c, str) for c in commands):
        raise wrong(f"{identifier}'s `approved-commands` holds a value that "
                    "is not a string")
    return tuple(commands)


def repo_key(cwd: Path) -> str:
    """The repo a working directory belongs to, named without asking
    worktrunk — because this is also what names a repo when worktrunk is
    the thing that failed. Walks up for the project config being checked,
    then for a git root. Two actors in two subdirectories of one repo must
    land on one key, or the pass reports the same repo twice.
    """
    here = cwd.resolve()
    for d in (here, *here.parents):
        if (d / ".config" / "wt.toml").is_file() or (d / ".git").exists():
            return str(d)
    return str(here)


def gate_readiness(cwd: Path, cache: dict[str, GateCheck]) -> GateCheck:
    """Is the repo at `cwd` one whose merge gate its agents can run?

    Evaluated once per repo per pass — several actors share one repo in
    practice, and the answer is about the repo, not the actor.

    Every failure is contained here and becomes an indeterminate verdict
    for this one repo. Nothing raises out of this function: the check is
    consulted from inside `up`, `status` and `server`, and a repo whose
    approvals store is reshaped must not take down a pass that also has
    unrelated actors to place and loop processes to start — least of all
    the server, which holds this open for as long as the host is in the
    fleet.
    """
    key = repo_key(cwd)
    if key in cache:
        return cache[key]
    try:
        check = _gate_readiness(cwd, key)
    except Indeterminate as e:
        check = GateCheck(key, "indeterminate", reason=str(e))
    except Exception as e:  # noqa: BLE001 — fail closed, never fail loudly
        check = GateCheck(key, "indeterminate",
                          reason=(f"the check raised an unexpected "
                                  f"{type(e).__name__}: {e}"))
    return cache.setdefault(key, check)


def _gate_readiness(cwd: Path, key: str) -> GateCheck:
    project = wt_project(cwd)
    identifier = project.get("identifier")
    # No project config is not a failed check: there is no gate here, so
    # there is nothing an agent could be unable to run.
    if not project.get("exists") or not project.get("path"):
        return GateCheck(key, "ready", identifier)

    # Worktrunk's own enumeration, not our parse of its grammar. A failure
    # here is indeterminate and never an empty template set — `wt hook
    # show` exits 1 with empty stdout on a config it cannot load, so "no
    # hooks" and "unreadable config" are one exit code apart.
    templates = project_hook_templates(cwd)
    if not templates:
        return GateCheck(key, "ready", identifier)
    # Templates to check but no identifier to key them on: worktrunk knows
    # of hooks here and we cannot tell whose grants would cover them.
    if not identifier:
        raise Indeterminate("worktrunk resolved no project identifier for "
                            "this repo, so its grants cannot be looked up")

    grants = granted_commands(identifier)
    # Exact equality on the unexpanded template text — the same text
    # worktrunk keys its own grants on, so one grant covers every branch's
    # expansion. Measured: a single added space defeats the match, which is
    # worktrunk's behaviour and therefore has to be this check's too.
    missing = tuple(t for t in templates if t not in grants)
    return GateCheck(key, "ready" if not missing else "ungranted",
                     identifier, templates, missing)


def report_gate(check: GateCheck, reported: set[str], indent: str = "",
                name_repo: bool = True) -> None:
    """Say why a repo was refused — once per repo per pass, however many
    actors resolve to it. Never a generic failure, and never a bypass.

    `name_repo` is False where the caller has already printed the repo, so
    the path is not said twice.
    """
    if check.key in reported:
        return
    reported.add(check.key)
    where = f"{check.key}: " if name_repo else ""
    if check.state == "indeterminate":
        print(f"{indent}{where}the hook-approval check could not be "
              f"made — {check.reason}")
        print(f"{indent}  no actor is started into a repo whose gate "
              "cannot be verified")
        return
    print(f"{indent}{where}hook approvals missing "
          f"({check.identifier})")
    for template in check.missing:
        print(f"{indent}  ungranted: {template}")
    print(f"{indent}  grant them once, interactively, with the working "
          f"directory inside that repo:")
    print(f"{indent}    {REMEDY}")


# Per-pass gate state. Module-level on purpose: the precondition binds at
# `start_actor`, the one seam every actor start goes through, so a caller
# added later inherits the guard by construction instead of having to
# remember to thread a cache through — which is exactly how the tracker-driven
# starts came to be missed once already, and why the server's loop starts go
# through `fresh_gate`. Cleared at the top of every pass, so a grant taken
# between passes is seen on the next one.
GATE_CACHE: dict[str, GateCheck] = {}
GATE_REPORTED: set[str] = set()


def begin_pass() -> None:
    GATE_CACHE.clear()
    GATE_REPORTED.clear()


def start_targets(manifest: dict, host: str
                  ) -> tuple[list[Path], list[tuple[str, str]]]:
    """What this host can inspect, and what it cannot — `(targets, skipped)`.

    A gate row may only be printed for a repo actually looked at. Another
    host's repo and a working directory absent from this machine have no
    config to read, and claiming either is gate-ready would be a statement
    about a gate nobody checked. So they are skipped — and every skip is
    returned with its reason, because a gate report covering fewer repos
    than the actor rows imply, with nothing saying why, reads as a clean
    bill of health for repos nobody checked. That silence is the disease
    this whole check exists to cure; it does not get to reappear in the
    report.
    """
    targets: list[Path] = []
    skipped: list[tuple[str, str]] = []
    rows = [(a.get("name", "?"), a.get("host"), a.get("cwd"))
            for a in manifest["actors"]]
    cwd_rel = manifest["top"].get("loops_cwd")
    if cwd_rel:
        rows.append(("(loops)", host, cwd_rel))
    for name, a_host, rel in rows:
        if a_host != host:
            skipped.append((name, f"placed on {a_host or '?'}, not this host"))
            continue
        if not rel:
            skipped.append((name, "no cwd: in the manifest"))
            continue
        cwd = (manifest["root"] / rel).resolve()
        if not cwd.is_dir():
            skipped.append((name, f"{rel} is not present on this machine"))
            continue
        targets.append(cwd)
    return targets, skipped


def gate_rows(repos: list[Path], indent: str = "") -> None:
    """Report gate-readiness, one row per distinct repo. Starts nothing."""
    seen: set[str] = set()
    for cwd in repos:
        check = gate_readiness(cwd, GATE_CACHE)
        if check.key in seen:
            continue
        seen.add(check.key)
        word = {"ready": "gate-ready",
                "ungranted": "NOT gate-ready",
                "indeterminate": "UNKNOWN"}[check.state]
        print(f"{indent}{check.key}  {word}")
        if not check.ok:
            report_gate(check, GATE_REPORTED, indent + "  ", name_repo=False)


def status(manifest: dict, host: str, session: str, env: dict) -> int:
    alive = herdr_agents(env)
    width = max((len(a.get("name", "")) for a in manifest["actors"]), default=4)
    print(f"fleet: {manifest['root']}  ·  session: {session}  ·  this host: {host}")
    print(f"{'actor':<{width}}  {'host':<12} {'state':<8} observed")
    drift = 0
    for a in manifest["actors"]:
        name = a.get("name", "?")
        observed = alive[name].get("agent_status", "alive") if name in alive else "absent"
        want = a.get("state", "?")
        mark = ""
        if want == "running" and name not in alive:
            mark, drift = "  ← wanted running", drift + 1
        if want == "parked" and name in alive:
            mark = "  ← running while parked"
        print(f"{name:<{width}}  {a.get('host','?'):<12} {want:<8} {observed}{mark}")
    # The merge gate its agents would have to run, per repo this host
    # places actors into. Reported, never acted on: status starts nothing,
    # and an ungranted repo is not drift.
    targets, skipped = start_targets(manifest, host)
    print()
    print("repo hook approvals")
    if targets:
        gate_rows(targets)
    if skipped:
        for name, why in skipped:
            print(f"{name}: not checked from here — {why}")
    if not targets and not skipped:
        print("no actors on this host")
    server_rows(manifest)
    return 1 if drift else 0


def send_prompt(name: str, text: str, env: dict) -> bool:
    sent = subprocess.run(["herdr", "agent", "prompt", name, text],
                          capture_output=True, text=True, env=env)
    if sent.returncode != 0:
        print(f"  prompt to {name} failed: {sent.stderr.strip()}")
        return False
    # A multi-line or slow-composer prompt can land unsubmitted — the
    # agent stays idle with the text sitting at its prompt. Verify it
    # went to work; one Enter submits a stuck composer. A fresh session
    # initializes for tens of seconds (plugin load), so the window is
    # generous — a first prompt regularly submits near the 30s mark.
    for _attempt in range(8):
        time.sleep(4)
        agent = herdr_agents(env).get(name, {})
        if agent.get("agent_status") == "working":
            return True
        subprocess.run(["herdr", "agent", "send-keys", name, "enter"],
                       capture_output=True, text=True, env=env)
    print(f"  {name} never went to work on the prompt — read its pane "
          "and prompt it by hand")
    return False


def start_actor(name: str, profile: str, model: str | None, cwd: Path,
                prompt: str | None, env: dict) -> bool:
    # The hook-approval precondition, bound at the seam every actor start
    # goes through rather than at each of the commands that start one. An
    # agent whose repo's merge gate it cannot run is an agent that will
    # stop mid-merge with no way to fix it, so it is not placed there.
    check = gate_readiness(cwd, GATE_CACHE)
    if not check.ok:
        print(f"{name}: not started — its repo's merge gate is not runnable")
        report_gate(check, GATE_REPORTED, "  ")
        return False
    print(f"starting {name} ({profile}, {model or 'default'})")
    try:
        tab = herdr_json(["herdr", "tab", "create", "--cwd", str(cwd),
                          "--label", name, "--no-focus"], env)
    except RuntimeError as e:
        print(f"  {e}")
        return False
    result = tab.get("result", {})
    tab_id = result.get("tab", {}).get("tab_id") or result.get("tab", {}).get("id")
    pane = result.get("root_pane", {}).get("pane_id")

    def close_tab():
        if tab_id:
            subprocess.run(["herdr", "tab", "close", str(tab_id)],
                           capture_output=True, text=True, env=env)
            print(f"  closed the orphaned tab {tab_id}")

    if not pane:
        print(f"  tab create returned no root_pane.pane_id: "
              f"{json.dumps(result)[:200]}")
        close_tab()
        return False
    # -n sets the session title at launch, so there is no rename to
    # race and the agent is addressable by its manifest name at once.
    # A fresh tab's shell can take a while to reach its prompt (devenv
    # init), and herdr reports agent_pane_busy until it does — poll.
    # Fleet agents run unattended; the fleet layer owns the permission
    # mode rather than leaving it to a shell wrapper.
    argv = ["herdr", "agent", "start", name, "--kind", "claude",
            "--pane", str(pane), "--timeout", "120000",
            "--", "--agent", profile, "-n", name,
            "--dangerously-skip-permissions"]
    if model:
        argv += ["--model", model]
    start = None
    for _attempt in range(12):
        start = subprocess.run(argv, capture_output=True, text=True, env=env)
        if start.returncode == 0 or "pane_busy" not in start.stderr:
            break
        time.sleep(10)
    if start.returncode != 0:
        print(f"  agent start failed: {start.stderr.strip()}")
        close_tab()
        return False
    # The pane's claude takes tens of seconds to reach its composer;
    # a prompt sent earlier strands unsubmitted or is lost outright.
    # Wait for the session to report interactive_ready before charging.
    for _attempt in range(30):
        if herdr_agents(env).get(name, {}).get("interactive_ready"):
            break
        time.sleep(4)
    if prompt:
        if not send_prompt(name, prompt, env):
            print(f"  {name} is alive but uncharged; prompt it by hand")
            return False
    return True


def up(manifest: dict, host: str, session: str, env: dict) -> int:
    alive = herdr_agents(env)
    failures = 0
    for a in manifest["actors"]:
        name = a["name"]
        if a.get("state") != "running" or name in alive:
            continue
        if a.get("host") != host:
            print(f"{name}: on {a.get('host')} — not this host, reach it via "
                  "herdr remote / ssh")
            continue
        cwd = (manifest["root"] / a["cwd"]).resolve()
        if not cwd.is_dir():
            print(f"{name}: cwd {a['cwd']} does not resolve under "
                  f"{manifest['root']}"); failures += 1
            continue
        if not start_actor(name, a["profile"], a.get("model"), cwd,
                           a.get("prompt"), env):
            failures += 1
    return 1 if failures else 0


SETTLED = {"idle", "done"}


# ---------------------------------------------------------------------------
# The server — one loop process per milestone with a job
#
# The job set is `_flywheel_inbox.server_inbox`, the actor it starts is a loop
# PROCESS, and there is no launch prompt anywhere in it: a program needs no
# invocation, only argv. Everything the operator sees, it sees in the log.
# ---------------------------------------------------------------------------

def server_config(manifest: dict, host: str, interval: int):
    top = manifest["top"]
    tracker = top.get("tracker", "")
    if "/" not in tracker:
        sys.exit("the server needs a `tracker: org/repo` line in fleet.yaml")
    org, repo = tracker.split("/", 1)
    cwd_rel = top.get("loops_cwd")
    if not cwd_rel:
        sys.exit("the server needs a `loops_cwd:` line in fleet.yaml — the "
                 "checkout its loop processes run in")
    loops_cwd = (manifest["root"] / cwd_rel).resolve()
    if not loops_cwd.is_dir():
        sys.exit(f"loops_cwd: {cwd_rel} does not resolve under "
                 f"{manifest['root']}")
    return server.ServerConfig(
        org=org, repo=repo, project=top.get("project", "Flywheel"),
        host=host, loops_cwd=loops_cwd, teams=manifest["teams"],
        interval=interval, bin_dir=Path(__file__).resolve().parent)


def fresh_gate(cwd: Path):
    """Gate-readiness for a loop start, never cached across passes.

    A loop process runs `wt merge` through the repo's hooks, so the actor
    precondition binds it too: ungranted, it would stop mid-merge with no
    way to fix it. The server is long-lived, so
    the cache is cleared on every call — a grant taken while it runs is seen
    at the next start rather than never.
    """
    begin_pass()
    check = gate_readiness(cwd, GATE_CACHE)
    if not check.ok:
        report_gate(check, GATE_REPORTED, "  ")
    return check


def dispatch_nudge(env: dict):
    """The only prompt the server ever sends.

    Dispatch survives as the one standing agent — triage and relay need a
    mind and a Discord channel — so it is still an agent in a pane, and this
    is still a herdr prompt. Everything else the server touches is a process.
    """
    def nudge(text: str) -> bool:
        agent = herdr_agents(env).get("dispatch")
        if not agent or agent.get("agent_status") not in SETTLED:
            print("dispatch work waiting; dispatch is "
                  + ("busy" if agent else "absent"))
            return True
        return send_prompt("dispatch", text, env)
    return nudge


def serve(manifest: dict, host: str, session: str, env: dict,
          interval: int, once: bool, dry_run: bool) -> int:
    # The loops this daemon spawns inherit ITS environment, and their herdr
    # calls must address the fleet's named session — without the socket they
    # silently address the default session and drive panes nobody watches.
    if "HERDR_SOCKET_PATH" in env:
        os.environ["HERDR_SOCKET_PATH"] = env["HERDR_SOCKET_PATH"]
    config = server_config(manifest, host, interval)
    tracker = inbox.Tracker(resolve_token(config.org), config.org, config.repo,
                            project_title=config.project)
    daemon = server.Server(
        config, tracker=tracker, gate=fresh_gate, nudge=dispatch_nudge(env),
        dry_run=dry_run)

    print(f"server · {config.org}/{config.repo}  ·  host: {host}  ·  "
          f"loops in {config.loops_cwd}"
          + ("  ·  DRY RUN" if dry_run else f"  ·  every {interval}s"))

    # A one-shot dry pass writes nothing and starts nothing, so it takes no
    # pidfile and does not care whether a real server is running beside it.
    if once and dry_run:
        return daemon.pass_once()

    existing = server.running_pid(config.org)
    if existing:
        sys.exit(f"a flywheel server for {config.org} is already running here "
                 f"(pid {existing}) — two would start every loop twice. Its "
                 f"log is {server.server_log(config.org)}")
    path = server.pid_path(config.org)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(f"{os.getpid()}\n")
    try:
        daemon.install_signals()
        return daemon.serve(interval=interval, once=once)
    finally:
        try:
            path.unlink()
        except OSError:
            pass


def start_server(manifest: dict, host: str, fleet: str | None) -> int:
    """`flywheel up` starts the server, per the record's Supersedes.

    Detached, because `up` converges a fleet and returns; the daemon it
    leaves behind has to outlive the shell that ran it. Its output is its
    log, which is the record's whole answer to operator visibility.
    """
    tracker = manifest["top"].get("tracker", "")
    org = tracker.split("/", 1)[0] if "/" in tracker else manifest["root"].name
    existing = server.running_pid(org)
    log = server.server_log(org)
    if existing:
        print(f"server: already running (pid {existing}) · log {log}")
        return 0
    argv = [str(Path(__file__).resolve()), "server", "--host", host]
    if fleet:
        argv += ["--fleet", fleet]
    try:
        pid = server.spawn_detached(argv, log)
    except OSError as error:
        print(f"server: could not start — {error}")
        return 1
    print(f"server: started (pid {pid}) · log {log}")
    return 0


def server_rows(manifest: dict) -> None:
    """What `status` says about the server: is it up, and what does the
    tracker want of it. Reads only; a tracker it cannot reach is reported,
    never fatal — status starts nothing and must never fail loudly."""
    tracker = manifest["top"].get("tracker", "")
    org = tracker.split("/", 1)[0] if "/" in tracker else manifest["root"].name
    pid = server.running_pid(org)
    print()
    print("server " + (f"running (pid {pid}) · log {server.server_log(org)}"
                       if pid else
                       "not running here — `flywheel up` starts it"))
    if "/" not in tracker:
        return
    org, repo = tracker.split("/", 1)
    cwd_rel = manifest["top"].get("loops_cwd")
    changes = ((manifest["root"] / cwd_rel).resolve() / "openspec" / "changes"
               if cwd_rel else None)
    try:
        box = inbox.Tracker(resolve_token(org), org, repo,
                            project_title=manifest["top"].get("project",
                                                              "Flywheel"))
        jobs = inbox.server_inbox(box.snapshot(with_edges=False),
                                  changes_dir=changes)
    except SystemExit as error:
        print(f"  tracker not readable from here — {error}")
        return
    except Exception as error:  # noqa: BLE001 — a report never dies
        print(f"  tracker not readable from here — "
              f"{error.__class__.__name__}: {error}")
        return
    if not jobs:
        print("  no milestone has a job")
        return
    for job in jobs:
        print(f"  {job.milestone}  {job.kind}  ({job.why})")

def down(manifest: dict) -> int:
    """Stop the server and every loop process for this org.

    The inverse of `up`, and only the processes: the org's herdr session,
    its panes, and dispatch stay — sessions are the operator's to keep or
    close, and a later `up` reattaches to them by name.
    """
    tracker = manifest["top"].get("tracker", "")
    org = tracker.split("/", 1)[0] if "/" in tracker else manifest["root"].name
    stopped = []
    pid = server.running_pid(org)
    if pid:
        try:
            os.kill(pid, signal.SIGTERM)
            stopped.append(f"server (pid {pid})")
        except OSError as error:
            print(f"server (pid {pid}): {error}")
    out = subprocess.run(
        ["pgrep", "-f", f"flywheel-(bolt|intent)-loop .*--org {org}"],
        capture_output=True, text=True)
    for line in out.stdout.split():
        try:
            os.kill(int(line), signal.SIGTERM)
            stopped.append(f"loop (pid {line})")
        except (OSError, ValueError):
            pass
    print("stopped: " + (", ".join(stopped) if stopped else "nothing running"))
    return 0


def main() -> int:
    args = sys.argv[1:]
    overrides = {}
    for flag in ("--host", "--fleet", "--interval"):
        if flag in args:
            i = args.index(flag)
            try:
                overrides[flag] = args[i + 1]
            except IndexError:
                sys.exit(f"{flag} needs a value")
            del args[i:i + 2]
    dry_run = "--dry-run" in args
    if dry_run:
        args.remove("--dry-run")
    once = "--once" in args
    if once:
        args.remove("--once")
    if len(args) != 1 or args[0] not in {"up", "status", "server", "down",
                                         "version"}:
        print(__doc__.strip())
        return 2
    if args[0] == "version":
        manifest_path = Path(__file__).resolve().parent.parent
        plugin = manifest_path / ".claude-plugin" / "plugin.json"
        v = "unknown"
        if plugin.exists():
            v = json.loads(plugin.read_text()).get("version", "unknown")
        print(f"flywheel {v} · {manifest_path}")
        return 0
    begin_pass()
    manifest = parse_manifest(find_manifest(overrides.get("--fleet")))
    if args[0] == "down":
        return down(manifest)
    session, env = session_env(manifest)
    host = this_host(manifest, overrides.get("--host"))
    if args[0] == "status":
        return status(manifest, host, session, env)
    if args[0] == "up":
        rc = up(manifest, host, session, env)
        return rc or start_server(manifest, host, overrides.get("--fleet"))
    # The server re-reads the manifest nowhere: it is read once here, and the
    # tracker — the thing that actually moves — is re-read every pass. A
    # manifest edit is an operator act, and restarting the daemon is how it
    # takes effect, which keeps "the tracker is the only bus" literally true.
    interval = int(overrides.get("--interval") or server.INTERVAL_S)
    return serve(manifest, host, session, env, interval, once, dry_run)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except GraphqlError as e:
        sys.exit(f"flywheel: graphql: {e}")

#!/usr/bin/env python3
"""flywheel-setup — converge an org's tracker to the flywheel's shape.

  flywheel-setup --org ORG --repo REPO [--project TITLE] [--team NAME ...]

Idempotent: run it any time, as often as wanted; it creates what is
missing and never rewrites what exists. Everything it touches is repo- or
project-level — org-level customization is deliberately outside the
flywheel's permissions.

What it converges, as the app identity (`GH_TOKEN`, or minted by the
sibling `flywheel-token` from `FLYWHEEL_GH_*`):

  - the tracker labels on the repo: `type:*` for the session types,
    `state:*` for the queue lifecycle, `stage:*` for where inside
    `state:in-progress` an item has reached, `closed:*` for the end
    reasons, `unit` and `elaboration` for the two batch kinds, and
    `needs-operator` for items blocked on the operator's word;
  - the org Project (default title "Flywheel"), linked to the repo —
    copied from the hand-built template project (--template, default
    "Flywheel Template") when one exists, because views and workflows
    cannot be configured through the API. The template's hand-built
    shape: the "Item added -> set Status" workflow DISABLED (measured:
    left on, it stamps the first Status option onto every auto-added
    item and floods the kanban) and "Auto-add to project" ENABLED with
    filter `is:issue is:open` (so Triage self-populates while the
    Board's lanes hold only what the tools set), plus the views —
    Board by Status showing only the Backlog and Ready columns (filter
    is:open no:parent-issue, sort Target asc); Roadmap by Start/Target
    grouped by Milestone, filter is:open no:parent-issue so only the
    approval carriers draw bars (sub-issues carry no dates or Team —
    the batch is the single scheduling source), month zoom, milestone
    markers, slice by Quarter; Triage table `is:open no:milestone`,
    oldest first; Waiting-on-me table `is:open
    label:needs-operator`; In-flight table `is:open
    label:state:in-progress` — the one place running construction is
    visible, since a consumed approval leaves the board's lanes; and
    Landed table `is:closed label:closed:done`, sliced by Quarter.
    Status options ordered
    Backlog, Ready first; Team options with the default host first,
    because the tools default to the first option;
  - its fields: Team (single select, from --team), Quarter (single
    select, the next six quarters), Start and Target (dates — what the
    roadmap lays items out by; no Iteration — the flywheel is
    continuous delivery, not sprint cadence), and the Status options
    the board uses (Backlog, Ready — added alongside whatever options
    the project already has).
"""

import argparse
import datetime
import json
import os
import subprocess
import sys
from pathlib import Path

TYPE_KINDS = [
    # design loop
    "planning", "interactive", "research", "prototype", "writeback",
    "handoff",
    # construction loop (proposal-writing survives as the exception path)
    "proposal-writing", "proposal-review", "spec-writing", "build", "test",
    "code-review", "human-code-review",
]

LABELS = {
    **{f"type:{k}": ("1d76db", f"{k} session work") for k in TYPE_KINDS},
    # not a session type: the released claim itself, worked through
    # spec, build and test with the stages living in its comments
    "type:assertion": ("0052cc", "a released claim; the bolt's work item"),
    "state:queued": ("ededed", "identified, awaiting release"),
    "state:ready": ("0e8a16", "approved by the operator; work may start"),
    "state:in-progress": ("fbca04", "a session is working it"),
    # `stage:*` refines `state:in-progress` and never replaces it: an item
    # carries its `state:*` label and, while a loop is working it, exactly
    # one `stage:*` naming the leading edge. Four are the bolt loop's, two
    # the intent loop's, and `stage:done` is the OPERATOR's — the one signal
    # the intent loop's completion filter consumes.
    "stage:planned": ("c2e0c6", "its spec validates"),
    "stage:built": ("c2e0c6", "the change is applied; a commit is on the "
                              "item's branch"),
    "stage:verified": ("c2e0c6", "verify came back clean"),
    "stage:merged": ("c2e0c6", "the work is on the bolt branch, not yet "
                               "landed"),
    "stage:in-session": ("f9d0c4", "a design session is carrying it"),
    "stage:done": ("f9d0c4", "the operator has marked it finished; the "
                             "intent loop collects on this"),
    "stage:collected": ("f9d0c4", "its deliverables are gathered"),
    "closed:done": ("2da44e", "finished; evidence on the item"),
    # A construction sub-issue closes at merge-back so the unit parent's
    # native bar advances there, and the landing upgrades the reason to
    # closed:done with the SHA. Invariant 5 stands verbatim: exactly one
    # closed:* reason on a closed item, at every moment.
    "closed:merged": ("1a7f37", "merged to the bolt branch; awaiting the "
                                "landing"),
    "closed:declined": ("b60205", "not doing it; reason on the item"),
    "closed:superseded": ("d93f0b", "overtaken by another item"),
    "closed:parked": ("c5def5", "waiting on an external event; reopenable"),
    "unit": ("d4a72c", "a release batch of construction work; items are "
                       "its sub-issues"),
    "elaboration": ("bfd4f2", "a proposed batch of design work; items are "
                              "its sub-issues"),
    "plan": ("8a63d2", "one proposed bolt awaiting approval; the plan "
                       "document is the card body"),
    "stale": ("ededed", "inputs moved since this plan card was derived; "
                        "still approvable"),
    "needs-operator": ("e99695",
                       "blocked on the operator's word; the question is the "
                       "latest comment"),
}

STATUS_OPTIONS = [
    ("Backlog", "GRAY", "batched, awaiting approval"),
    ("Ready", "GREEN", "approved by the operator; work may start"),
]


def gh(token, *args, input_json=None):
    env = dict(os.environ, GH_TOKEN=token)
    stdin = json.dumps(input_json) if input_json is not None else None
    proc = subprocess.run(
        ["gh", *args], env=env, input=stdin, capture_output=True, text=True
    )
    if proc.returncode != 0:
        sys.exit(f"flywheel-setup: gh {' '.join(args[:2])} failed: "
                 f"{proc.stderr.strip() or proc.stdout.strip()}")
    return json.loads(proc.stdout) if proc.stdout.strip() else {}


class GraphqlError(Exception):
    pass


def graphql(token, query, variables=None):
    body = {"query": query, "variables": variables or {}}
    data = gh(token, "api", "/graphql", "--input", "-", input_json=body)
    if data.get("errors"):
        raise GraphqlError(data["errors"][0]["message"])
    return data["data"]


def ensure_labels(token, org, repo):
    existing = {
        l["name"]
        for l in gh(token, "api", f"/repos/{org}/{repo}/labels", "--paginate")
    }
    created = []
    for name, (color, desc) in LABELS.items():
        if name in existing:
            continue
        gh(token, "api", f"/repos/{org}/{repo}/labels", "--input", "-",
           input_json={"name": name, "color": color, "description": desc})
        created.append(name)
    return created


def ensure_project(token, org, title, template=None):
    data = graphql(token, """
      query($org: String!) {
        organization(login: $org) {
          id
          projectsV2(first: 100) { nodes { id title number } }
        }
      }""", {"org": org})
    org_id = data["organization"]["id"]
    nodes = data["organization"]["projectsV2"]["nodes"]
    for node in nodes:
        if node["title"] == title:
            return node["id"], node["number"], False
    # Views cannot be created through the API; copying a hand-built
    # template project is the one way to arrive with the board and
    # roadmap views preset. The copy brings views and fields both.
    if template:
        for node in nodes:
            if node["title"] == template:
                copied = graphql(token, """
                  mutation($project: ID!, $owner: ID!, $title: String!) {
                    copyProjectV2(input: {projectId: $project,
                                          ownerId: $owner, title: $title,
                                          includeDraftIssues: false}) {
                      projectV2 { id number }
                    }
                  }""", {"project": node["id"], "owner": org_id,
                         "title": title})["copyProjectV2"]["projectV2"]
                return copied["id"], copied["number"], True
        print(f"template: no project titled '{template}' — creating bare "
              "(views must then be configured by hand once)")
    created = graphql(token, """
      mutation($owner: ID!, $title: String!) {
        createProjectV2(input: {ownerId: $owner, title: $title}) {
          projectV2 { id number }
        }
      }""", {"owner": org_id, "title": title})["createProjectV2"]["projectV2"]
    return created["id"], created["number"], True


def ensure_link(token, org, repo, project_id):
    data = graphql(token, """
      query($org: String!, $repo: String!) {
        repository(owner: $org, name: $repo) {
          id
          projectsV2(first: 100) { nodes { id } }
        }
      }""", {"org": org, "repo": repo})
    repo_id = data["repository"]["id"]
    if project_id in {n["id"] for n in data["repository"]["projectsV2"]["nodes"]}:
        return "already linked"
    try:
        graphql(token, """
          mutation($project: ID!, $repo: ID!) {
            linkProjectV2ToRepository(
              input: {projectId: $project, repositoryId: $repo}
            ) { repository { id } }
          }""", {"project": project_id, "repo": repo_id})
    except GraphqlError as e:
        # Linking needs the repo-level Projects permission, which the app
        # deliberately does not request. Everything that matters — adding
        # items, fields, the Status moves — works without the link; it only
        # surfaces the project in the repo's Projects tab. One manual
        # "Add project" there does the same.
        return (f"skipped ({e}) — link it once by hand in the repo's "
                "Projects tab, or grant the app repo-level Projects access")
    return "linked"


def project_fields(token, project_id):
    nodes = graphql(token, """
      query($project: ID!) {
        node(id: $project) {
          ... on ProjectV2 {
            fields(first: 50) {
              nodes {
                ... on ProjectV2FieldCommon { id name dataType }
                ... on ProjectV2SingleSelectField {
                  options { id name description }
                }
              }
            }
          }
        }
      }""", {"project": project_id})["node"]["fields"]["nodes"]
    return {n["name"]: n for n in nodes if n}


def create_field(token, project_id, name, data_type, **extra):
    graphql(token, """
      mutation($input: CreateProjectV2FieldInput!) {
        createProjectV2Field(input: $input) {
          projectV2Field { ... on ProjectV2FieldCommon { id } }
        }
      }""", {"input": {"projectId": project_id, "name": name,
                       "dataType": data_type, **extra}})


def next_quarters(count=6):
    today = datetime.date.today()
    year, q = today.year, (today.month - 1) // 3 + 1
    out = []
    for _ in range(count):
        out.append(f"{year}-Q{q}")
        q += 1
        if q == 5:
            year, q = year + 1, 1
    return out


def ensure_fields(token, project_id, teams):
    fields = project_fields(token, project_id)
    made = []

    if "Team" not in fields:
        create_field(token, project_id, "Team", "SINGLE_SELECT",
                     singleSelectOptions=[
                         {"name": t, "color": "BLUE", "description": ""}
                         for t in teams])
        made.append("Team")

    if "Quarter" not in fields:
        create_field(token, project_id, "Quarter", "SINGLE_SELECT",
                     singleSelectOptions=[
                         {"name": q, "color": "GRAY", "description": ""}
                         for q in next_quarters()])
        made.append("Quarter")

    for name in ("Start", "Target"):
        if name not in fields:
            create_field(token, project_id, name, "DATE")
            made.append(name)

    status = fields.get("Status")
    if status and "options" in status:
        have = {o["name"] for o in status["options"]}
        want = [(n, c, d) for n, c, d in STATUS_OPTIONS if n not in have]
        if want:
            options = [
                {"id": o["id"], "name": o["name"], "color": "GRAY",
                 "description": o.get("description") or ""}
                for o in status["options"]
            ] + [{"name": n, "color": c, "description": d}
                 for n, c, d in want]
            graphql(token, """
              mutation($input: UpdateProjectV2FieldInput!) {
                updateProjectV2Field(input: $input) {
                  projectV2Field { ... on ProjectV2FieldCommon { id } }
                }
              }""", {"input": {"fieldId": status["id"],
                               "singleSelectOptions": options}})
            made.append("Status options: " + ", ".join(n for n, _, _ in want))
    return made


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--org", required=True)
    ap.add_argument("--repo", required=True)
    ap.add_argument("--project", default="Flywheel", metavar="TITLE")
    ap.add_argument("--template", default="Flywheel Template", metavar="TITLE",
                    help="org project to copy (views included) when the "
                         "project is missing; built by hand once per org")
    ap.add_argument("--team", action="append", default=None,
                    help="Team option; repeatable (default: flywheel)")
    args = ap.parse_args()

    token = os.environ.get("GH_TOKEN")
    if not token:
        helper = Path(__file__).resolve().parent / "flywheel-token"
        proc = subprocess.run([str(helper), "--org", args.org],
                              capture_output=True, text=True)
        if proc.returncode != 0:
            sys.exit(proc.stderr.strip())
        token = proc.stdout.strip()

    created = ensure_labels(token, args.org, args.repo)
    print(f"labels: created {len(created)}" +
          (f" ({', '.join(created)})" if created else ", all present"))

    project_id, number, fresh = ensure_project(token, args.org, args.project,
                                               template=args.template)
    print(f"project: {'created' if fresh else 'found'} "
          f"'{args.project}' (#{number})")

    print(f"link: {ensure_link(token, args.org, args.repo, project_id)}")

    made = ensure_fields(token, project_id, args.team or ["flywheel"])
    print("fields: " + ("; ".join(made) if made else "all present"))


if __name__ == "__main__":
    try:
        main()
    except GraphqlError as e:
        sys.exit(f"flywheel-setup: graphql: {e}")

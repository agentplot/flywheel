#!/usr/bin/env python3
"""flywheel-board — put items on the org Project board.

  flywheel-board --org ORG --repo REPO [--project Flywheel] [--status NAME] \\
      ITEM_NUMBER ...

Adds each item to the Project and, with --status, sets its Status —
and defaults Start and Target to today (override with --start/--target
and a stated reason when the work is bigger; automation first). The
board rule: whatever carries the approval sits on the board — units
and elaborations, which flywheel-batch adds at Backlog. A born-ready
release's unit parent is moved to Ready with this tool at triage (the
operator's word there IS the approval, so nothing is left to approve),
which is what puts it on the roadmap and in front of the reconciler's
Ready query like any released batch. The released items themselves stay
off the board: the parent is the row, and it is what carries GitHub's
native sub-issue progress bar for the bolt.
Token: `GH_TOKEN`, or minted by the sibling `flywheel-token`.
"""

import argparse
import datetime
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _flywheel_gh import (GraphqlError, add_to_project, find_project, gh,
                          project_date_field, project_single_select,
                          resolve_token, set_item_option, set_item_value,
                          set_select_default)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--org", required=True)
    ap.add_argument("--repo", required=True)
    ap.add_argument("--project", default="Flywheel", metavar="TITLE")
    ap.add_argument("--status", metavar="NAME")
    ap.add_argument("--start", metavar="YYYY-MM-DD")
    ap.add_argument("--target", metavar="YYYY-MM-DD")
    ap.add_argument("--quarter", metavar="YYYY-Qn")
    ap.add_argument("--team", metavar="NAME",
                    help="board Team (routes the milestone's host); "
                         "defaults to the field's first option")
    ap.add_argument("items", nargs="+", type=int, metavar="ITEM_NUMBER")
    args = ap.parse_args()

    token = resolve_token(args.org)
    project_id = find_project(token, args.org, args.project)
    if not project_id:
        sys.exit(f"flywheel-board: no project titled '{args.project}' — "
                 "run flywheel-setup first")
    field_id = options = None
    if args.status:
        field_id, options = project_single_select(token, project_id, "Status")
        if args.status not in options:
            sys.exit(f"flywheel-board: the Status field has no "
                     f"'{args.status}' option (have: {', '.join(options)})")
    today = datetime.date.today().isoformat()
    dates = [("Start", args.start or today), ("Target", args.target or today)]
    date_fields = {name: project_date_field(token, project_id, name)
                   for name, _ in dates}
    for n in args.items:
        issue = gh(token, "api", f"/repos/{args.org}/{args.repo}/issues/{n}")
        item_id = add_to_project(token, project_id, issue["node_id"])
        if args.status:
            set_item_option(token, project_id, item_id, field_id,
                            options[args.status])
        for name, date in dates:
            if date_fields[name]:
                set_item_value(token, project_id, item_id,
                               date_fields[name], {"date": date})
        quarter = args.quarter
        if not quarter:
            t = datetime.date.today()
            quarter = f"{t.year}-Q{(t.month - 1) // 3 + 1}"
        team_set = set_select_default(token, project_id, item_id, "Team",
                                      args.team)
        quarter_set = set_select_default(token, project_id, item_id,
                                         "Quarter", quarter)
        print(f"#{n} on '{args.project}'"
              + (f" · Status {args.status}" if args.status else "")
              + " · " + ", ".join(f"{n.lower()} {d}" for n, d in dates)
              + (f" · team {team_set}" if team_set else "")
              + (f" · quarter {quarter_set}" if quarter_set else ""))


if __name__ == "__main__":
    try:
        main()
    except GraphqlError as e:
        sys.exit(f"flywheel-board: graphql: {e}")
